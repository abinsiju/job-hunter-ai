# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local

# --- PostgreSQL (host port 5433 avoids clash with other local projects) ---
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jobhunter
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# --- AI provider (swap "ollama" for another provider later) ---
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_CHAT_MODEL=qwen3:4b
AI_EMBED_MODEL=nomic-embed-text
AI_NUM_CTX=8192
AI_API_KEY=

# --- Storage (local now, S3-compatible later) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data
S3_ENDPOINT=
S3_BUCKET=

# --- Browser automation ---
BROWSER_BACKEND=local

# --- App ---
BACKEND_PORT=8000
FRONTEND_PORT=3100

# --- Auth (single user). Run: cd backend && uv run python ../scripts/set_password.py ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# --- Job discovery (free keys: https://developer.adzuna.com/signup) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Apply assist (see SECURITY.md) ---
# Gmail credentials are NOT stored here: run scripts/set_gmail.sh to save them in the macOS Keychain.
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SSL=true
ASSIST_HEADLESS=false
